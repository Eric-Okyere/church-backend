# MongoDB Atlas connection string. Note this backend's own historical name
# for this var is MONGODBLK_URI (not the more common MONGODB_URI) — match
# whatever src/db.js actually reads.
MONGODBLK_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# Any long random string — used to sign login JWTs.
JWT_SECRET=

# Comma-separated list of frontend origins allowed by CORS. The FIRST one
# listed is also used as the base URL for links sent in password-reset
# emails, so put your real production URL first.
FRONTEND_URL=https://churchcivic.netlify.app,http://localhost:3000

PORT=4000

# Read only by `npm run seed` (local dev convenience — creates one demo
# church + admin). Not used in production; churches self-serve sign up via
# the frontend's /signup page instead.
ADMIN_NAME=Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
CHURCH_NAME=Demo Church
CHURCH_LATITUDE=5.54834
CHURCH_LONGITUDE=-0.33557
CHURCH_CHECKIN_RADIUS_METERS=200

# Read only by `npm run seed:platform-admin` — creates/updates the one
# cross-church platform-admin login (see /platform).
PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=

# Resend (https://resend.com) — sends password-reset emails. Get an API key
# from your Resend dashboard. Without a verified domain, Resend's shared
# "onboarding@resend.dev" sender (the default if RESEND_FROM_EMAIL is left
# unset) only delivers to your OWN Resend account's email — verify a domain
# you control (e.g. linkpiichurch.com) to email real churches.
RESEND_API_KEY=
RESEND_FROM_EMAIL=GraceTrack <onboarding@resend.dev>
